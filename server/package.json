{
  "name": "yanga-bet-server",
  "version": "1.0.0",
  "description": "Backend server for Yanga Bet",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "node --require ./test/setup.js --test --test-concurrency=1 test/*.test.js",
    "test:money": "node --require ./test/setup.js test/money.test.js",
    "test:auth": "node --require ./test/setup.js test/auth.test.js",
    "test:boot": "node --require ./test/setup.js test/boot.test.js",
    "db:apply": "node scripts/apply-schema.js",
    "admin:create": "node scripts/create-admin.js",
    "reconcile": "node scripts/reconcile.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.1",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "jsonwebtoken": "^9.0.0",
    "socket.io": "^4.6.1"
  },
  "devDependencies": {
    "nodemon": "^2.0.22"
  }
}
