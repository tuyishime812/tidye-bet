# ============================================
# AVIATOR CRASH GAME - ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in your actual values

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5001
NODE_ENV=development

# ============================================
# FRONTEND URL (for CORS)
# ============================================
FRONTEND_URL=http://localhost:3000

# ============================================
# JWT SECRET  (REQUIRED - the server refuses to start without it)
# ============================================
# SECURITY: this value signs every player AND admin JWT. Anyone who knows it can
# mint an admin token and rewrite any player's balance, so it must be unique,
# unguessable, and NEVER committed to version control.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# Minimum enforced length is 24 characters (32+ recommended). The server also
# refuses to start if the value still contains placeholder text such as
# "your-", "change-this" or "example", because anything left here is published
# in this file. Rotate the value to invalidate every existing session.
JWT_SECRET=

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
# Browser/anonymous key - used ONLY for reading the caller's own rows via
# PostgREST. It can never move money (see SCHEMA.sql RLS).
SUPABASE_KEY=your-supabase-anon-key-here
# Service-role key - REQUIRED for USE_SUPABASE=true. Every balance/hold write
# goes through the apply_movement() RPC which only the service role may call;
# the anon key above is useless for money. Fetch it from
# Project Settings > API > service_role. NEVER put it in the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# PAYCHANGU PAYMENT CONFIGURATION (primary deposit gateway)
# ============================================
# Sign up at: https://paychangu.com

# API Keys (start with sec- and pub-)
PAYCHANGU_SECRET_KEY=sec-your-secret-key-here
PAYCHANGU_PUBLIC_KEY=pub-your-public-key-here

# Environment: test or production
PAYCHANGU_ENVIRONMENT=test

# Timeout for the two gateway calls (initialize + verify), in milliseconds.
PAYCHANGU_TIMEOUT_MS=15000

# ============================================
# OPTIONAL: EMAIL CONFIGURATION (for notifications)
# ============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# ============================================
# ADMIN CREDENTIALS  (BOOTSTRAP / BREAK-GLASS)
# ============================================
# Admin accounts now live in the database (SCHEMA.sql SECTION 7b, the `admins`
# table), so you create and rotate them from the Supabase dashboard and do NOT
# redeploy. These env values are the BOOTSTRAP account: they are only accepted
# while the `admins` table is empty or unavailable, so you always have a way in
# before you have created your first database admin.
#
# The server refuses to start without them unless ADMIN_AUTH_MODE=db.
#
#   ADMIN_EMAIL      login identifier (preferred), e.g. boss@example.com
#   ADMIN_USERNAME   legacy login identifier when no ADMIN_EMAIL is set
#   ADMIN_PASSWORD_HASH  bcrypt hash of the password (PREFERRED)
#   ADMIN_PASSWORD   plaintext fallback, minimum 12 characters
#
# Generate a bcrypt hash (the plaintext password never enters the env file):
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'your-password'
#
# The old "admin123" default is rejected at boot. Use a unique passphrase, e.g.
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
#
# Create your real admin(s) after applying the schema:
#   node scripts/create-admin.js --username boss        (or --sql to paste it)
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=

# How an admin login is authenticated:
#   auto (default) - the database is authoritative once it holds >=1 admin;
#                    otherwise the bootstrap account above is accepted.
#   db             - database only; the bootstrap account is never accepted.
#                    Requires USE_SUPABASE=true (+ the service-role key).
#   env            - the old behaviour: the account above only, ignore the table.
#   supabase       - Supabase Auth only (email/password against GoTrue). Requires
#                    SUPABASE_URL and SUPABASE_KEY (anon) or SUPABASE_SERVICE_ROLE_KEY.
ADMIN_AUTH_MODE=auto

# Authorise Supabase Auth admin logins by allow-list (used when logging in with
# an email via Supabase Auth). Comma/space separated. Leave empty if using only
# app_metadata.is_admin/role on the user (also supported), but deny-by-default
# applies if neither is present. You do NOT need this for the table/env sources.
ADMIN_EMAILS=

# ============================================
# GAME INTEGRITY CONTROLS
# ============================================
# Allow an operator to force the next round's crash point (Admin -> CRASH
# CONTROL). This is a money-minting primitive and it breaks the provable-fairness
# claim, so it is OFF by default when NODE_ENV=production and ON only in
# non-production environments for testing.
#
# Every override is written to audit_logs with the acting admin, and a forced
# round is flagged `forced=true` in game_rounds. /api/game/round-details then
# reports `verifiable:false, reason:"operator_override"` for that round.
#
# Set to `true` only for a licensed, supervised demo environment. Leave unset in
# production.
ALLOW_MANUAL_CRASH=false

# Start every round in manual mode (wait for the operator's crash point). If
# true, MANUAL_CRASH_FALLBACK_MS controls how long the round waits before it
# automatically resumes with a normal seed-derived crash point. 0 waits forever;
# the maximum is 300000 ms.
ADMIN_MANUAL_DEFAULT=false
MANUAL_CRASH_FALLBACK_MS=20000

# ============================================
# OPTIONAL: FOOTBALL (sportsbook) CONFIGURATION
# ============================================
# USE_SUPABASE=false keeps balances, bets, deposits, withdrawals and audit rows
# in memory, which is fine for development but loses everything on restart.
# Set to true and apply server/SCHEMA.sql (the consolidated schema: games,
# ledger, RLS, apply_movement) to persist them. The server refuses to boot with
# USE_SUPABASE=true unless the database is reachable and the ledger RPC exists.
USE_SUPABASE=false

# Where the admin panel is served from. Added to the CORS allow-list at boot.
# Use the exact production origin, e.g. https://admin.yourdomain.mw
ADMIN_SITE_URL=
